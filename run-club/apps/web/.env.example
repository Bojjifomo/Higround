# Copy to .env.local. Everything may stay empty: the app then runs on the mock Intervals provider.

# Supabase (project settings → API). Leave empty until the project exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (used for redirects and the mock provider).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Intervals.icu OAuth app (SPEC §3). Empty CLIENT_ID or REDIRECT_URI = mock provider.
# Tick "Public Client" + "Require PKCE" on the intervals.icu app and leave CLIENT_SECRET empty.
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=
INTERVALS_REDIRECT_URI=
INTERVALS_WEBHOOK_SECRET=

# Yoga Quest WhatsApp gate (SPEC §8): off until the group link exists.
YOGA_WA_GATE=false
WA_GROUP_URL=
