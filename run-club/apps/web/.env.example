# Copy to .env.local. Everything may stay empty: the app then runs in demo mode (made-up club, mock provider).

# ── Supabase (Project Settings → API / Database). Demo mode until URL, anon key AND DATABASE_URL are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Database → Connect → "Session pooler" connection string (with your database password)
DATABASE_URL=
# optional: Database → SSL configuration → download certificate, paste its contents (verifies the server)
DATABASE_CA_CERT=

# Public URL of this app (magic links, OAuth redirects, QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Who gets which role when they first sign up (comma-separated emails)
ADMIN_EMAILS=
INSTRUCTOR_EMAILS=

# ── Intervals.icu OAuth app (SPEC §3). Empty CLIENT_ID or REDIRECT_URI = mock provider.
# Tick "Public Client" + "Require PKCE" on the intervals.icu app and leave CLIENT_SECRET empty.
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=
# must be <NEXT_PUBLIC_SITE_URL>/api/intervals/callback, registered exactly on intervals.icu
INTERVALS_REDIRECT_URI=
# webhook URL to register on intervals.icu: <NEXT_PUBLIC_SITE_URL>/api/intervals/webhook
INTERVALS_WEBHOOK_SECRET=

# ── Secrets for jobs and events (any long random strings)
CRON_SECRET=
EVENT_QR_SECRET=

# ── Yoga Quest WhatsApp gate (SPEC §8): off until the group link exists.
YOGA_WA_GATE=false
WA_GROUP_URL=

# ── AI Running Coach (Google Gemini API — optional; local preview runs when empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Giveaway Winner Email via Resend (optional; giveaway logs still work locally when empty)
RESEND_API_KEY=
RESEND_FROM=Higround Run Club <onboarding@resend.dev>

# ── Official Higround Spotify/YouTube Playlist URL override (optional)
NEXT_PUBLIC_HIGROUND_PLAYLIST_URL=
